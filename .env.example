# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Testing vs paying
# FREE_MODE=true  → no Stripe; /studio auto-unlocks for free testing
# FREE_MODE=false → production paying mode (Checkout required)
FREE_MODE=true

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Database — Neon / Vercel Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Replicate (optional locally — falls back to sharp posterize)
REPLICATE_API_TOKEN=r8_...
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

# Upstash Redis rate limiting (optional — in-memory fallback used if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local only — POST /api/dev/unlock { "secret": "..." } to open /studio without Stripe
DEV_UNLOCK_SECRET=local-dev-unlock
