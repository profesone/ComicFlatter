APP_URL=http://localhost:8080
APP_ENV=local
FREE_MODE=true

# Session signing helper (32+ chars) — also used for CSRF pepper
APP_KEY=replace-with-a-long-random-secret-at-least-32-chars

# DreamHost MySQL (or local)
DB_HOST=mysql.example.com
DB_PORT=3306
DB_NAME=comicflats
DB_USER=comicflats
DB_PASS=secret

STORAGE_DIR=storage/uploads

# Stripe https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price (price_...) or Product (prod_...). A product uses its active price.
COMICFLATTER_PRICE_ID=price_...
COMICBALLOON_POPPER_PRICE_ID=price_...

# flood = local hard-edge regions. sam is reserved for a future SAM 2 service.
SEGMENTER=flood

# Unused until a SAM 2 backend is wired
REPLICATE_API_TOKEN=

# Password reset mail (optional From)
MAIL_FROM=ComicFlats <noreply@example.com>
