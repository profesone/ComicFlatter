# App (DDEV)
NEXT_PUBLIC_APP_URL=https://comicflatter.ddev.site
SESSION_SECRET=ddev-local-session-secret-change-me-32chars

# Testing vs paying
# FREE_MODE=true  → no Stripe; /studio auto-unlocks for free testing
# FREE_MODE=false → production paying mode (Checkout required)
FREE_MODE=true

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Database — DDEV Postgres (inside container host is "db"; from the Mac use ddev describe for the host port)
DATABASE_URL=postgresql://db:db@db:5432/db

# Local file storage (DDEV / shared hosting)
STORAGE_DIR=storage/uploads

# Replicate (optional locally — falls back to sharp posterize)
REPLICATE_API_TOKEN=r8_...
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

# Upstash Redis rate limiting (optional — in-memory fallback used if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local only — POST /api/dev/unlock { "secret": "..." } to open /studio without Stripe
DEV_UNLOCK_SECRET=local-dev-unlock
